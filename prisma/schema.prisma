generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  CHEQUE
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Company {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?
  taxNumber   String?
  website     String?
  logo        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Client {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  mobile      String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  country     String?
  notes       String?

  invoices    Invoice[]
  quotations  Quotation[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([email])
}

model Invoice {
  id             String         @id @default(cuid())
  invoiceNumber  String         @unique

  issueDate      DateTime
  dueDate        DateTime?
  numberOfDays   Int?   @default(0)

  subtotal       Decimal        @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @db.Decimal(12, 2)

  notes          String?
  status         InvoiceStatus  @default(DRAFT)

  client         Client         @relation(fields: [clientId], references: [id])
  clientId       String

  items          InvoiceItem[]
  payments       Payment[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([invoiceNumber])
  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id            String    @id @default(cuid())

  description   String
  quantity      Int

  unitPrice     Decimal   @db.Decimal(12, 2)
  amount        Decimal   @db.Decimal(12, 2)

  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String

  createdAt     DateTime  @default(now())

  @@index([invoiceId])
}

model Payment {
  id             String         @id @default(cuid())

  amount         Decimal        @db.Decimal(12, 2)
  paymentDate    DateTime

  paymentMethod  PaymentMethod
  reference      String?
  notes          String?

  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([invoiceId])
}

model Quotation {
  id               String            @id @default(cuid())
  quotationNumber  String            @unique

  issueDate        DateTime
  dueDate          DateTime?
  numberOfDays     Int?              @default(0)

  subtotal         Decimal           @db.Decimal(12, 2)
  taxAmount        Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal           @db.Decimal(12, 2)

  notes            String?
  status           QuotationStatus   @default(DRAFT)

  client           Client            @relation(fields: [clientId], references: [id])
  clientId         String

  items            QuotationItem[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([quotationNumber])
  @@index([clientId])
  @@index([status])
}

model QuotationItem {
  id            String      @id @default(cuid())

  description   String
  quantity      Int

  unitPrice     Decimal     @db.Decimal(12, 2)
  amount        Decimal     @db.Decimal(12, 2)

  quotation     Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  quotationId   String

  createdAt     DateTime    @default(now())

  @@index([quotationId])
}

model User {
  id        String   @id
  name      String?
  email     String   @unique
  mobile    String?
  createdAt DateTime @default(now())
}
